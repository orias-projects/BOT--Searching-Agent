# ============================================================================
# RAG System - Environment Configuration Template
# ============================================================================
# HƯỚNG DẪN:
# 1. Copy file này thành .env: cp .env.example .env
# 2. Điền mật khẩu PostgreSQL của bạn vào DB_PASSWORD
# 3. Nếu password có ký tự đặc biệt (@ # ? &), cần URL-encode trong DATABASE_URL
#    Ví dụ: LongK@170105 → LongK%40170105
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_vectors
DB_USER=postgres
DB_PASSWORD=your_password_here

# Full connection URL
# ⚠️ QUAN TRỌNG: Password có ký tự đặc biệt phải URL-encode
# @ → %40, # → %23, ? → %3F, & → %26, space → %20
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rag_vectors

# ============================================================================
# VECTOR SEARCH CONFIGURATION
# ============================================================================

# Enable PostgreSQL pgvector
USE_PG_VECTOR=true

# Minimum similarity score (0.0 - 1.0)
# Higher = stricter, Lower = more results
SEARCH_THRESHOLD=0.7

# Vector dimension (PhoBERT = 768)
VECTOR_DIMENSION=768

# ============================================================================
# EMBEDDING MODEL
# ============================================================================

# Model từ HuggingFace (Vietnamese semantic search)
EMBEDDING_MODEL=VoVanPhuc/sup-SimCSE-VietNamese-phobert-base

# Device: cpu hoặc cuda (nếu có GPU)
EMBEDDING_DEVICE=cpu

# Rerank model (optional, để trống nếu không dùng)
RERANK_MODEL=

# ============================================================================
# SEARCH PRIORITY BONUSES
# ============================================================================
# Điều chỉnh độ ưu tiên cho từng bảng trong kết quả tìm kiếm
# Giá trị cao hơn = ưu tiên cao hơn

PRIORITY_BASES=0.0
PRIORITY_ANSWERS=0.03
PRIORITY_CRAWLS=0.02
PRIORITY_RESPONS=0.01
PRIORITY_CHUNKS=0.0

# ============================================================================
# DATABASE CONNECTION POOL
# ============================================================================

# Số lượng kết nối pool tối đa
PG_POOL_SIZE=10

# Số kết nối overflow cho phép
PG_MAX_OVERFLOW=5

# ============================================================================
# API SERVER (Optional)
# ============================================================================

# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# ============================================================================
# DEVELOPMENT (Optional)
# ============================================================================

# DEBUG=false
# AUTO_RELOAD=true

# ============================================================================
# NOTES
# ============================================================================
#
# 1. KHÔNG commit file .env lên git (đã có trong .gitignore)
# 2. Tool encode password: https://www.urlencoder.org/
# 3. Test kết nối: python -c "from src.backends.database.pgConnection import PGConnection; PGConnection()"
#
# ============================================================================
